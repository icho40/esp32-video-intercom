<?xml version="1.0" encoding="utf-8"?>
<!-- Klingelzuordnung und Stationsadresse gehoeren zum Geraet: nicht sichern und
     nicht auf ein neues Geraet uebertragen, damit dort beim ersten Start die
     Klingelauswahl erscheint. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="intercom_settings.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="intercom_settings.xml" />
    </device-transfer>
</data-extraction-rules>
